# Next.js Super Admin Frontend Environment Configuration
# Copy this to .env.local for local development or pass via Docker Compose / runtime environment

# API Backend Gateway URL (Client-side accessible URL)
# For local dev: http://localhost:5000/api
# For production VPS: https://api.yourdomain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Tenant Studio Main App URL (for linking to studio views)
# For local dev: http://localhost:3000
# For production VPS: https://app.yourdomain.com
NEXT_PUBLIC_STUDIO_APP_URL=http://localhost:3000

